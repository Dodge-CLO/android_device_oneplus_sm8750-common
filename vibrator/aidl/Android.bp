cc_library_static {
    name: "libvibrator_pal_shim.oplus_sm8750",
    vendor: true,
    srcs: ["pal_shim.c"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    include_dirs: [
        "vendor/qcom/opensource/pal/inc",
        "vendor/qcom/opensource/audioreach-graphservices/spf/api/modules",
    ],
    header_libs: [
        "libspf-headers",
        "libarosal_headers",
    ],
    shared_libs: [
        "liblog",
        "libpalclient",
    ],
}

rust_defaults {
    name: "vendor.qti.hardware.vibrator.service.oplus_sm8750-defaults",
    vendor: true,
    prefer_rlib: true,
    srcs: ["main.rs"],
    rustlibs: [
        "android.hardware.vibrator-V2-rust",
        "libbinder_rs",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libnix",
        "librustutils",
    ],
    static_libs: ["libvibrator_pal_shim.oplus_sm8750"],
    shared_libs: [
        "liblog",
        "libpalclient",
    ] + select(soong_config_variable("qti_vibrator", "effect_lib"), {
        // A device may override the effect lib (e.g. a haptic-profile-aware
        // one) via qti_vibrator/effect_lib; default keeps the common impl.
        any @ flag_val: [flag_val],
        default: ["libqtivibratoreffect.oplus_sm8750"],
    }),
}

rust_binary {
    name: "vendor.qti.hardware.vibrator.service.oplus_sm8750",
    defaults: ["vendor.qti.hardware.vibrator.service.oplus_sm8750-defaults"],
    relative_install_path: "hw",
    init_rc: ["vendor.qti.hardware.vibrator.service.oplus_sm8750.rc"],
    vintf_fragments: ["vendor.qti.hardware.vibrator.service.oplus_sm8750.xml"],
}

rust_test {
    name: "vendor.qti.hardware.vibrator.service.oplus_sm8750-test",
    defaults: ["vendor.qti.hardware.vibrator.service.oplus_sm8750-defaults"],
    test_suites: ["general-tests"],
}

prebuilt_etc {
    name: "HapticsPolicy.xml",
    vendor: true,
    src: "HapticsPolicy.xml",
}
