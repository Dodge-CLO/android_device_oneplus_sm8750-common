# Audio
af.fast_track_multiplier=1
audio.deep_buffer.media=true
audio.offload.min.duration.secs=30
audio.offload.video=true
ro.af.client_heap_size_kbyte=7168

# Bluetooth
bluetooth.device_id.vendor_id=0x001D

# GMS
ro.opa.device_model_id=ga-oplus-skill-os121-211011

# LMK
ro.lmk.relaxed_available_memory=true
ro.lmk.swap_compression_ratio=2

# Memory: mmd (Rust) sets up zram after boot and maintains it: the same lz4 6 GiB swap the
# vendor script used to create, plus zstd recompression of idle pages and writeback of cold
# pages to /data, capped at 1 GiB per day.
mmd.zram.enabled=true
mmd.zram.comp_algorithm=lz4
mmd.zram.size=6442450944
mmd.zram.device_priority=32758
mmd.zram.recompression.enabled=true
mmd.zram.recompression.algorithm=zstd
mmd.zram.writeback.enabled=true
mmd.zram.writeback.max_bytes_per_day=1073741824
# mmd_setup may not read the UFS queue depth (sysfs nr_tags); pass it instead.
mmd.zram.writeback.use_nr_tags_prop=true
mmd.zram.writeback.nr_tags=63

# Boot: replay the page cache recorded on an earlier boot (prefetch, Rust)
ro.prefetch_boot.enabled=true

# Text: read fonts with Fontations (Skrifa, Rust) instead of FreeType.
# Back to FreeType at runtime: setprop debug.hwui.text.backend 1
debug.hwui.text.backend=2
