soong_namespace {
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/WCNSS_qcom_cfg.ini",
    symlink_target: "/odm/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "CneApp.libvndfwk_detect_jni.qti_vendor_symlink",
    vendor: true,
    installed_location: "app/CneApp/lib/arm64/libvndfwk_detect_jni.qti.so",
    symlink_target: "/vendor/lib64/libvndfwk_detect_jni.qti_vendor.so",
    required: ["libvndfwk_detect_jni.qti_vendor"],
}
